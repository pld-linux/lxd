+  curl -k -s \
+    --cert "${LXD_CONF}/chain_target.crt" \
+    --key "${LXD_CONF}/chain_target.key" \
+    "https://${LXD_ADDR}/1.0" | jq --exit-status '.metadata.auth == "untrusted"'
