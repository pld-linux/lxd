+  lxc config trust remove "${leaf_fingerprint}"
+  rm "${TEST_DIR}/chain_injected.pem" "${TEST_DIR}/spoofed_chain.pem"
+  rm "${LXD_CONF}"/{chain_leaf,chain_target,untrusted_attacker}.{crt,key}
