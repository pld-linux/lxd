+++ b/lxd/request/request.go
@@ -2,11 +2,20 @@ package request
 
 import (
 	"context"
+	"crypto/x509"
+	"errors"
 	"net"
+	"net/http"
 
 	"github.com/canonical/lxd/shared/api"
 )
 
+// ErrNoCertificate is returned if the request does not contain a certificate.
+var ErrNoCertificate = errors.New("No certificate present in request")
+
+// ErrNoTLS is returned if the request does not have a TLS connection.
+var ErrNoTLS = errors.New("No TLS connection state")
+
 // CreateRequestor extracts the lifecycle event requestor data from the provided context.
 func CreateRequestor(ctx context.Context) *api.EventLifecycleRequestor {
 	requestor, err := GetRequestorAuditor(ctx)
@@ -22,3 +31,16 @@ func CreateRequestor(ctx context.Context) *api.EventLifecycleRequestor {
 func SaveConnectionInContext(ctx context.Context, connection net.Conn) context.Context {
 	return context.WithValue(ctx, CtxConn, connection)
 }
+
+// GetPeerCertificate returns the first peer certificate in the request TLS connection states peer certificate list.
+func GetPeerCertificate(r *http.Request) (*x509.Certificate, error) {
+	if r.TLS == nil {
+		return nil, api.StatusErrorf(http.StatusBadRequest, "%w", ErrNoTLS)
+	}
+
+	if len(r.TLS.PeerCertificates) == 0 {
+		return nil, api.StatusErrorf(http.StatusBadRequest, "%w", ErrNoCertificate)
+	}
+
+	return r.TLS.PeerCertificates[0], nil
+}
diff --git a/lxd/request/request_test.go b/lxd/request/request_test.go
new file mode 100644
index 000000000000..0385785ac816
--- /dev/null
+++ b/lxd/request/request_test.go
@@ -0,0 +1,68 @@
+package request
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/canonical/lxd/shared/api"
+)
+
+func TestGetPeerCertificate(t *testing.T) {
+	certA := &x509.Certificate{Raw: []byte("certA")}
+	certB := &x509.Certificate{Raw: []byte("certB")}
+
+	tests := []struct {
+		name        string
+		tlsState    *tls.ConnectionState
+		wantCert    *x509.Certificate
+		wantErr     error
+		wantErrCode int
+	}{
+		{
+			name:        "no TLS connection",
+			wantErr:     ErrNoTLS,
+			wantErrCode: http.StatusBadRequest,
+		},
+		{
+			name: "TLS with empty peer certificates",
+			tlsState: &tls.ConnectionState{
+				PeerCertificates: []*x509.Certificate{},
+			},
+			wantErr:     ErrNoCertificate,
+			wantErrCode: http.StatusBadRequest,
+		},
+		{
+			name: "TLS with single certificate",
+			tlsState: &tls.ConnectionState{
+				PeerCertificates: []*x509.Certificate{certA},
+			},
+			wantCert: certA,
+		},
+		{
+			name: "TLS with certificate chain",
+			tlsState: &tls.ConnectionState{
+				PeerCertificates: []*x509.Certificate{certA, certB},
+			},
+			wantCert: certA,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			req, err := http.NewRequest(http.MethodGet, "/", nil)
+			require.NoError(t, err)
+			req.TLS = tt.tlsState
+
+			cert, err := GetPeerCertificate(req)
+			require.ErrorIs(t, err, tt.wantErr)
+			require.Equal(t, tt.wantCert, cert)
+			if err != nil && tt.wantErrCode != 0 {
+				require.True(t, api.StatusErrorCheck(err, tt.wantErrCode))
+			}
+		})
+	}
+}
